# ---------------------------------------------------------------------------
# বাজার দর (BazarDor) — environment variables
# Copy this file to `.env.local` for local development and add the same keys
# in Vercel → Project → Settings → Environment Variables for deployment.
# ---------------------------------------------------------------------------

# REQUIRED in production. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the deployment (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# OPTIONAL — PostgreSQL (Neon / Vercel Postgres / Supabase).
# Without it Better Auth keeps users + sessions in memory.
DATABASE_URL=

# OPTIONAL — social login. Create the OAuth apps first:
#   Google: https://console.cloud.google.com/apis/credentials
#     Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
#   GitHub: https://github.com/settings/developers
#     Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
